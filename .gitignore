# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with potentially sensitive data
*.tfvars
*.tfvars.json
!*.example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# OS & Editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo